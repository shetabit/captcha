<?xml version="1.0"?>
<ruleset name="Captcha">
    <description>The coding standard of the captcha package.</description>

    <file>config</file>
    <file>src</file>
    <file>tests</file>

    <!-- Show progress and sniff codes, and colorize the output. -->
    <arg name="colors"/>
    <arg value="ps"/>

    <!-- The soft limit on the line length is a warning, it must not fail the build. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR2"/>

    <!-- The routes of a driver and the helpers are scripts, not classes. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>src/Drivers/*/routes\.php</exclude-pattern>
        <exclude-pattern>src/helpers\.php</exclude-pattern>
    </rule>
</ruleset>
